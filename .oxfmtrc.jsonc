{
    "$schema": "./node_modules/oxfmt/configuration_schema.json",
    "quoteStyle": "single",
    "jsxQuoteStyle": "double",
    "semi": true,
    "tabWidth": 4,
    "printWidth": 140,
    "trailingComma": "all",
    "bracketSpacing": true,
    "arrowParentheses": "always",
    "endOfLine": "lf",
    "insertFinalNewline": true,
    "ignorePatterns": [
        "out/**",
        "node_modules/**",
        ".vscode-test/**",
        "src/parser/grammar.ts",
        "src/completion/generated/**",
        "tmp_*.ts",
        "test-*.js",
        "package-lock.json",
        "media/**",
    ],
}
